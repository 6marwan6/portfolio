# Server-only. Never expose these to the browser. For local dev copy this file to .env.local.
# Groq (OpenAI-compatible). Create a key at console.groq.com/keys.
GROQ_API_KEY=
# Optional: any other OpenAI-compatible provider (then also set the key as LLM_API_KEY and the models below).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Qwen 3.8 27B on Groq is a PREVIEW model: check console.groq.com/docs/models, preview models can change or be retired.
AGENT_MODEL=qwen/qwen3.8-27b
RECRUITER_MODEL=qwen/qwen3.8-27b
# Daily spend ceiling in USD. With the prices below, real token usage is metered; without them, spend is estimated per request.
DAILY_SPEND_CAP_USD=2
EST_COST_PER_REQUEST_USD=0.002
# Prices per million tokens in USD, as listed on Groq's models page when this was written (they can change): check them.
PRICE_IN_PER_MTOK=0.8
PRICE_OUT_PER_MTOK=4
RATE_LIMIT_PER_IP_PER_MIN=8
# Optional: Upstash / Vercel KV REST credentials so limits and the spend cap are shared across server instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
